{
  "name": "@zeno-lib/db",
  "version": "0.9.0",
  "repository": {
    "url": "https://github.com/zeno-lib/zeno.git",
    "directory": "packages/db"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./auth": {
      "types": "./dist/auth-schema.d.mts",
      "import": "./dist/auth-schema.mjs",
      "default": "./dist/auth-schema.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs",
      "default": "./dist/errors.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs",
      "default": "./dist/next.mjs"
    },
    "./query": {
      "types": "./dist/query.d.mts",
      "import": "./dist/query.mjs",
      "default": "./dist/query.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs",
      "default": "./dist/schema.mjs"
    },
    "./triggers": {
      "types": "./dist/triggers.d.mts",
      "import": "./dist/triggers.mjs",
      "default": "./dist/triggers.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm exec supabase start",
    "prepack": "tsdown",
    "reset": "pnpm exec supabase db reset",
    "stop": "pnpm exec supabase stop",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@zeno-lib/schema": "workspace:*",
    "@zeno-lib/test": "workspace:*",
    "@zeno-lib/typescript": "workspace:^",
    "dotenv": "18.0.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "postgres": "3.4.9",
    "react": "^19.3.0",
    "supabase": "2.120.0",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "postgres": ">=3.4",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
