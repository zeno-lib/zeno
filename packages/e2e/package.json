{
  "name": "@zeno-lib/e2e",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.mts",
      "import": "./dist/auth.mjs",
      "default": "./dist/auth.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./verify-deps": {
      "types": "./dist/verify-deps.d.mts",
      "import": "./dist/verify-deps.mjs",
      "default": "./dist/verify-deps.mjs"
    }
  },
  "bin": {
    "zeno-e2e": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "https://github.com/zeno-lib/zeno.git",
    "directory": "packages/e2e"
  },
  "scripts": {
    "build": "tsdown",
    "e2e": "playwright test",
    "e2e:watch": "playwright test --ui",
    "prepack": "tsdown",
    "test": "vitest --run",
    "types:check": "tsc --noEmit",
    "verify-deps": "node ./dist/cli.mjs verify-deps"
  },
  "peerDependencies": {
    "@playwright/test": ">=1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^25.6.0",
    "@zeno-lib/docs": "workspace:*",
    "@zeno-lib/test": "workspace:*",
    "@zeno-lib/typescript": "workspace:^",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
