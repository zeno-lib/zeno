{
  "name": "@zeno-lib/test",
  "version": "1.0.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "default": "./dist/vitest.js"
    },
    "./configs": {
      "types": "./dist/configs/index.d.ts",
      "import": "./dist/configs/index.js",
      "default": "./dist/configs/index.js"
    },
    "./testing-library": {
      "types": "./dist/testing-library.d.ts",
      "import": "./dist/testing-library.js",
      "default": "./dist/testing-library.js"
    },
    "./user-event": {
      "types": "./dist/user-event.d.ts",
      "import": "./dist/user-event.js",
      "default": "./dist/user-event.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
