{
  "name": "@zeno-lib/test",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/zeno-lib/zeno.git",
    "directory": "packages/test"
  },
  "type": "module",
  "exports": {
    "./configs": {
      "types": "./dist/configs/index.d.mts",
      "import": "./dist/configs/index.mjs",
      "default": "./dist/configs/index.mjs"
    },
    "./testing-library": {
      "types": "./dist/testing-library.d.mts",
      "import": "./dist/testing-library.mjs",
      "default": "./dist/testing-library.mjs"
    },
    "./user-event": {
      "types": "./dist/user-event.d.mts",
      "import": "./dist/user-event.mjs",
      "default": "./dist/user-event.mjs"
    },
    "./supabase": {
      "types": "./dist/supabase.d.mts",
      "import": "./dist/supabase.mjs",
      "default": "./dist/supabase.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "prepack": "tsdown",
    "test": "vitest --run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "26.6.4",
    "@zeno-lib/typescript": "workspace:^",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.56.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
