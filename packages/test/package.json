  "dependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "vite-tsconfig-paths": "6.1.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@zeno-lib/typescript": "workspace:^",
    "tsdown": "^0.22.2",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vitest": "4.1.0"
  }
}
