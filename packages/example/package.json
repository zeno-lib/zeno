{
  "name": "@zeno-lib/example",
  "private": true,
  "scripts": {
    "dev": "pnpm exec supabase start",
    "stop": "pnpm exec supabase stop",
    "reset": "pnpm exec supabase db reset && pnpm db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.106.1",
    "@zeno-lib/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@zeno-lib/typescript": "workspace:^",
    "@zeno-lib/test": "workspace:*",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.5",
    "drizzle-orm": "0.44.6",
    "drizzle-seed": "0.3.1",
    "postgres": "3.4.7",
    "supabase": "2.31.8",
    "typescript": "5.9.3"
  }
}
