{
  "name": "@zeno-lib/forms",
  "version": "0.2.2",
  "repository": {
    "url": "https://github.com/zeno-lib/zeno.git",
    "directory": "packages/forms"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./create-form": "./src/create-form.tsx",
    "./form-dialog": "./src/form-dialog.tsx",
    "./lib/*": {
      "types": "./dist/lib/*.d.mts",
      "import": "./dist/lib/*.mjs",
      "default": "./dist/lib/*.mjs"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.mts",
      "import": "./dist/tanstack.mjs",
      "default": "./dist/tanstack.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "prepack": "tsdown",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-form-nextjs": "1.33.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@zeno-lib/test": "workspace:^",
    "@zeno-lib/typescript": "workspace:^",
    "@zeno-lib/ui": "workspace:^",
    "lucide-react": "^1.52.0",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-devtools": ">=0.10",
    "@tanstack/react-form-devtools": ">=0.2",
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-devtools": {
      "optional": true
    },
    "@tanstack/react-form-devtools": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
