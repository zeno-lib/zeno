{
  // shadcn serves each file that a package's `registry.json` lists, and no workspace imports it.
  "name": "registry",
  "detection": { "type": "fileExists", "pattern": "packages/*/registry.json" },
  "entryPointRole": "runtime",
  "manifestEntries": [
    {
      "manifests": "packages/*/registry.json",
      "entries": [{ "path": "${items[*].files[*].path}" }]
    }
  ]
}
